---
/**
 * Starlight's footer (prev / next), then the site footer: brand with a
 * "Star on GitHub" button, link groups and license.
 */
import DefaultFooter from "@astrojs/starlight/components/Footer.astro"
import { Icon } from "@astrojs/starlight/components"
import LogoMark from "@/components/brand/logo-mark.astro"
import { GITHUB_REPO_URL } from "@/data/env"
import { formatStars, getGitHubStars } from "@/lib/github-stars"

const stars = await getGitHubStars(GITHUB_REPO_URL)

// One list drives the footer columns.
const groups = [
  {
    title: "Docs",
    links: [
      { label: "Introduction", href: "/getting-started/introduction/" },
      { label: "Installation", href: "/getting-started/installation/" },
      { label: "Components", href: "/getting-started/components/" },
      { label: "Changelog", href: "/changelog/" },
    ],
  },
  {
    title: "Examples",
    links: [
      { label: "Table examples", href: "/examples/" },
      { label: "Grid examples", href: "/data-grid/examples/" },
      { label: "Blocks", href: "/blocks/" },
    ],
  },
  {
    title: "Community",
    links: [
      { label: "GitHub", href: GITHUB_REPO_URL },
      { label: "Contributing", href: "/contributing/" },
      {
        label: "Request a component",
        href: "/contributing/component-request/",
      },
      { label: "Request a feature", href: "/contributing/feature-request/" },
    ],
  },
]
const year = new Date().getFullYear()
---

<DefaultFooter />

<footer class="site-footer not-content">
  <div class="site-footer-top">
    <div class="site-footer-brand">
      <a href="/" class="site-footer-logo">
        <LogoMark size="1.25rem" />
        Niko Table
      </a>
      <p>Composable data tables and an editable grid for shadcn/ui.</p>
      <p>Built on TanStack Table. You own the code.</p>
      <a href={GITHUB_REPO_URL} class="star-button">
        <Icon name="star" size="1rem" />
        Star on GitHub
        {stars !== null && <span class="star-count">{formatStars(stars)}</span>}
      </a>
    </div>
    <nav class="site-footer-groups" aria-label="Footer">
      {groups.map(group => (
        <div>
          <h2>{group.title}</h2>
          <ul>
            {group.links.map(link => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
  </div>
  <div class="site-footer-bottom">
    <p>MIT License. Copyright {year} Semir N.</p>
    <p>Not affiliated with shadcn/ui or TanStack.</p>
  </div>
</footer>

<style>
  .site-footer .star-button {
    margin-top: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    color: var(--foreground);
    text-decoration: none;
    font-weight: 500;
    white-space: nowrap;
  }
  .site-footer .star-button:hover {
    background: var(--accent);
  }
  .site-footer {
    margin-top: 4rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--border);
    font-size: var(--sl-text-sm);
    color: var(--muted-foreground);
  }
  .site-footer-top {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 2fr);
    gap: 2.5rem;
  }
  .site-footer-brand p {
    margin: 0.5rem 0 0;
    max-width: 22rem;
  }
  .site-footer .site-footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--foreground);
    font-weight: 600;
    font-size: var(--sl-text-base);
    text-decoration: none;
  }
  .site-footer-groups {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }
  .site-footer-groups h2 {
    margin: 0 0 0.75rem;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    color: var(--foreground);
  }
  .site-footer-groups ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.5rem;
  }
  .site-footer a {
    color: inherit;
    text-decoration: none;
  }
  .site-footer-groups a:hover {
    color: var(--foreground);
  }
  .site-footer a:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
    border-radius: 0.25rem;
  }
  .site-footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin-top: 2.5rem;
    padding-block: 1.25rem 0.5rem;
    border-top: 1px solid var(--border);
    font-size: var(--sl-text-xs);
  }
  .site-footer-bottom p {
    margin: 0;
  }
  @media (max-width: 50rem) {
    .site-footer-top {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 30rem) {
    .site-footer-groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .star-count {
    padding-inline-start: 0.5rem;
    border-inline-start: 1px solid var(--border);
    color: var(--muted-foreground);
    font-variant-numeric: tabular-nums;
  }
</style>
