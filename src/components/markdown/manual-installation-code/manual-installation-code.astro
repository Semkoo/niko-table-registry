---
import {
  getManualInstallationFiles,
  groupFilesByDirectory,
} from "@/lib/manual-installation-files"
import { ManualInstallationCodeInternal } from "./_manual-installation-code-internal"

// Only the file manifest is serialized into the island. Source and highlighted
// markup are fetched per file from /manual-install/<path>.json on expand.
const filesByDirectory = groupFilesByDirectory(
  await getManualInstallationFiles(),
)
---

<ManualInstallationCodeInternal
  filesByDirectory={filesByDirectory}
  client:load
/>
