---
import { InstallationTabsInternal } from "@/components/markdown/installation-tabs/_installation-tabs-internal"
import CliCommandCode from "@/components/markdown/cli-command-code/cli-command-code.astro"
import type {
  RegistryFileType,
  RegistryItemSchema,
} from "@/types/shadcn-registry"
import { ManualInstallCodeCard } from "@/components/manual-install-code-card"

type RegistryItem =
  | "data-table"
  | "data-table-virtualized"
  | "data-table-pagination"
  | "data-table-search-filter"
  | "data-table-sort-menu"
  | "data-table-view-menu"
  | "data-table-view-dnd-menu"
  | "data-table-clear-filter"
  | "data-table-filter-menu"
  | "data-table-faceted-filter"
  | "data-table-inline-filter"
  | "data-table-slider-filter"
  | "data-table-date-filter"
  | "data-table-export-button"
  | "data-table-aside"
  | "data-table-selection-bar"
  | "data-table-column-sort"
  | "data-table-column-hide"
  | "data-table-column-pin"
  | "data-table-column-resize"
  | "data-table-column-faceted-filter"
  | "data-table-column-slider-filter"
  | "data-table-column-date-filter"
  | "data-table-row-dnd"
  | "data-table-column-dnd"
  | "data-table-grid"
  | "data-table-grid-changes"

type Props = { registryItem: RegistryItem }

const { registryItem } = Astro.props

const module = (await import(`../../../../public/r/${registryItem}.json`))
  .default as RegistryItemSchema

const filesToCopy = module.files?.map(file => {
  const pathFromType = getFileLocationFromType(file.type)
  return {
    path:
      file.target ??
      `${pathFromType}/${registryItem}.${file.path.split(".").pop()}`,
    fileId: toManualInstallId(file.path),
  }
})

const npmModulesToInstall = module.dependencies
const registryDependencies = module.registryDependencies
  ?.map(dep => {
    if (dep.startsWith("http")) {
      // A niko-table registry item; the components page catalogs every item.
      return {
        name: dep
          .split("/")
          .pop()
          ?.replace(/\.json$/, "")
          .replaceAll("-", " "),
        href: "/getting-started/components/",
      }
    } else {
      // This is a shadcn/ui dependency.
      return {
        name: dep.replaceAll("-", " "),
        href: `https://ui.shadcn.com/docs/components/${dep}`,
      }
    }
  })
  .filter(d => d.name != null)

// The card loads code from /manual-install/<id>.json, which only serves files
// under src/components/niko-table — fail the build rather than ship a dead card.
function toManualInstallId(filePath: string) {
  const prefix = "src/components/niko-table/"
  if (!filePath.startsWith(prefix)) {
    throw new Error(
      `${registryItem}: ${filePath} is not served by /manual-install`,
    )
  }
  return filePath.slice(prefix.length)
}

function getFileLocationFromType(type: RegistryFileType) {
  switch (type) {
    case "registry:ui":
      return "components/ui"
    case "registry:page":
    case "registry:file":
      throw new Error("Page and file types require a target")
    case "registry:component":
      return "src/components"
    case "registry:lib":
      return "src/lib"
    case "registry:hook":
      return "src/hooks"
    case "registry:block":
    case "registry:style":
    case "registry:theme":
      // Not sure what to do with these types yet
      throw new Error("Block, style, and theme types are not supported yet")
    default:
      throw new Error(`Unknown file type: ${type satisfies never}`)
  }
}
---

<div>
  <!-- @ts-expect-error: This component takes a cliSteps prop but the only way to pass that in with Astro is with a slot -->
  <InstallationTabsInternal client:load>
    <div slot="cliSteps" class="flex flex-col gap-4">
      <CliCommandCode
        action="run"
        command={`shadcn@latest add @niko-table/${registryItem}`}
      />
      <p class="text-sm text-muted-foreground">
        Requires the <code>@niko-table</code> registry in your <code
          >components.json</code
        >. See the <a
          href="/getting-started/installation/#configure-the-niko-table-registry"
          class="underline underline-offset-3">Installation Guide</a
        > for setup. Or install directly via URL:
      </p>
      <CliCommandCode
        action="run"
        command={`shadcn@latest add "https://niko-table.com/r/${registryItem}.json"`}
      />
    </div>
    <div class="flex flex-col gap-8">
      {
        registryDependencies != null && registryDependencies.length > 0 && (
          <div class="flex flex-col gap-4">
            <p>
              This component relies on other items which must be installed
              first.
            </p>
            <ul class="list-disc pl-10">
              {registryDependencies.map(dep => (
                <li>
                  <a
                    href={dep.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="capitalize underline underline-offset-3"
                  >
                    {dep.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
      {
        npmModulesToInstall != null && npmModulesToInstall.length > 0 && (
          <div class="flex flex-col gap-4">
            <p>Install the following dependencies.</p>
            <CliCommandCode
              action="install"
              command={npmModulesToInstall.join(" ")}
            />
          </div>
        )
      }
      {
        filesToCopy != null && filesToCopy.length > 0 && (
          <div class="flex flex-col gap-4">
            <p>Copy and paste the following code into your project.</p>
            {filesToCopy.map(file => (
              <ManualInstallCodeCard
                client:load
                filePath={file.path}
                fileId={file.fileId}
              />
            ))}
          </div>
        )
      }
      <p>Update the import paths to match your project setup.</p>
    </div>
  </InstallationTabsInternal>
</div>
